MQ-2 →

VCC → 5V

GND → GND

A0 → A0

LED verde → Pin 8

LED arancione → Pin 9

LED rosso → Pin 10

Buzzer → Pin 11

(Con resistenza da 220Ω per ogni LED)








**CODICE**

// Pin
const int sensorPin = A0;
const int ledVerde = 2;
const int ledArancione = 4;
const int ledRosso = 7;
const int buzzer = 11;

// Soglie
int sogliaVerde = 500;     // Sotto 500: Aria pulita
int sogliaArancione = 700;  // Tra 500 e 700: Attenzione
int sogliaRosso = 850;      // Sopra 850: Pericolo

void setup() {
  pinMode(ledVerde, OUTPUT);
  pinMode(ledArancione, OUTPUT);
  pinMode(ledRosso, OUTPUT);
  pinMode(buzzer, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int valoreGas = analogRead(sensorPin);
  Serial.print("Livello Gas: ");
  Serial.println(valoreGas);

  if (valoreGas < sogliaVerde) {
    // Sicurezza - Solo Verde
    digitalWrite(ledVerde, HIGH);
    digitalWrite(ledArancione, LOW);
    digitalWrite(ledRosso, LOW);
    noTone(buzzer);
  } 
  else if (valoreGas < sogliaRosso) { 
    // Attenzione - Solo Arancione (valore tra 500 e 849)
    digitalWrite(ledVerde, LOW);
    digitalWrite(ledArancione, HIGH);
    digitalWrite(ledRosso, LOW);
    noTone(buzzer);
  } 
  else {
    // Pericolo - Rosso + Buzzer (valore >= 850)
    digitalWrite(ledVerde, LOW);
    digitalWrite(ledArancione, LOW);
    digitalWrite(ledRosso, HIGH);
    tone(buzzer, 1000); 
  }

  delay(500); // Ritardo unico per stabilità lettura
}

