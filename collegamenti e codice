🔌 Collegamenti

MQ-2 →

VCC → 5V

GND → GND

A0 → A0

LED verde → Pin 8

LED arancione → Pin 9

LED rosso → Pin 10

Buzzer → Pin 11

(Con resistenza da 220Ω per ogni LED)








**CODICE**

#define sensorPin A0

const int ledVerde = 2;
const int ledArancione = 4;
const int ledRosso = 7;

const int buzzer = 11;

int sogliaVerde = 230;
int sogliaArancione = 370;
int sogliaRosso = 450;

int stato = -1;

// filtro (USALO)
int leggiGas() {
  long somma = 0;

  for (int i = 0; i < 15; i++) {
    somma += analogRead(sensorPin);
    delay(5);
  }

  return somma / 15;
}

void setup() {
  pinMode(ledVerde, OUTPUT);
  pinMode(ledArancione, OUTPUT);
  pinMode(ledRosso, OUTPUT);
  pinMode(buzzer, OUTPUT);

  Serial.begin(9600);
}

void loop() {

  int valoreGas = leggiGas();

  Serial.println(valoreGas);

  // 🔴 ROSSO
  if (valoreGas > sogliaRosso && stato != 2) {
    stato = 2;

    digitalWrite(ledVerde, LOW);
    digitalWrite(ledArancione, LOW);
    digitalWrite(ledRosso, HIGH);
    digitalWrite(buzzer, HIGH);
  }

  // 🟠 ARANCIONE
  else if (valoreGas > sogliaArancione && stato != 1) {
    stato = 1;

    digitalWrite(ledVerde, LOW);
    digitalWrite(ledArancione, HIGH);
    digitalWrite(ledRosso, LOW);
    digitalWrite(buzzer, LOW);
  }

  // 🟢 VERDE
  else if (stato != 0) {
    stato = 0;

    digitalWrite(ledVerde, HIGH);
    digitalWrite(ledArancione, LOW);
    digitalWrite(ledRosso, LOW);
    digitalWrite(buzzer, LOW);
  }

  delay(400);
}
